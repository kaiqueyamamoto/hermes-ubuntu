# Copie para .env e preencha ao menos um provedor de modelo.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Painel web (sobe no boot, http://localhost:9119).
# Sem senha definida, uma é gerada e salva em /root/.hermes/dashboard-password
# (veja com `make password`).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Porta no host
HERMES_DASHBOARD_PORT=9119
