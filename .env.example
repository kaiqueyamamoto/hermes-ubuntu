# Copie para .env e preencha ao menos um provedor de modelo.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Painel web (sobe no boot, http://localhost:9119).
# Sem senha definida, uma é gerada e salva em /root/.hermes/dashboard-password
# (veja com `make password`).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Porta no host
HERMES_DASHBOARD_PORT=9119

# Tailscale: com TS_AUTHKEY o container entra na tailnet no boot.
# Gere em https://login.tailscale.com/admin/settings/keys (reutilizável, não efêmera).
# Hermes Desktop → Settings → Gateways → Remote: http://<TS_HOSTNAME>:9119
TS_AUTHKEY=
TS_HOSTNAME=hermes
# true = HTTPS pela tailnet (https://<TS_HOSTNAME>.<tailnet>.ts.net), exige HTTPS ligado na tailnet
TS_SERVE=
# Flags extras para `tailscale up`, ex.: --advertise-tags=tag:hermes
TS_EXTRA_ARGS=
